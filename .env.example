# Techub Arbitrades App - Environment Configuration

# Poloniex API
POLONIEX_API_KEY=your_poloniex_api_key
POLONIEX_SECRET_KEY=your_poloniex_secret_key

# MEXC API
MEXC_API_KEY=your_mexc_api_key
MEXC_SECRET_KEY=your_mexc_secret_key

# Trading Pairs
TRADING_PAIR_POLONIEX=TRN_USDT
TRADING_PAIR_MEXC=TRNUSDT

# Trading Parameters
TRANSFER_AMOUNT_USDT=15
CYCLE_DURATION_HOURS=24
SPREAD_THRESHOLD_PERCENT=0.5
ENGINE_PORT=3001

# Paper Trading (set to false for live trading)
PAPER_TRADING=true

# Deposit/Withdrawal Addresses
POLONIEX_TRN_DEPOSIT_ADDRESS=0x...
POLONIEX_TRN_NETWORK=ETHARB
MEXC_TRN_DEPOSIT_ADDRESS=0x...
MEXC_TRN_NETWORK=ARBITRUM_ONE
POLONIEX_USDT_DEPOSIT_ADDRESS=0x...
POLONIEX_USDT_NETWORK=BSC_BEP20
TRN_CONTRACT_ADDRESS=0x...
